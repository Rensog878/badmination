# Razorpay (https://dashboard.razorpay.com/app/keys). Use test keys (rzp_test_...) until launch.
# Copy to .env.local and fill in. Without these, registration still works but online payment is disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks (Dashboard → Settings → Webhooks): URL https://<your-domain>/api/razorpay/webhook,
# events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=
