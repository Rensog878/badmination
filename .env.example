# Database: MongoDB Atlas (free M0 is fine). Without it the site runs on built-in sample data and admin is disabled.
MONGODB_URI=
MONGODB_DB=badminton

# Media: Cloudflare R2 (10 GB free, no egress fees). Public URL = the bucket's r2.dev URL or custom domain.
# The bucket needs a CORS rule allowing PUT from your site's origin (Content-Type header).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Razorpay (https://dashboard.razorpay.com/app/keys). Use test keys (rzp_test_...) until launch.
# Copy to .env.local and fill in. Without these, registration still works but online payment is disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks (Dashboard → Settings → Webhooks): URL https://<your-domain>/api/razorpay/webhook,
# events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# Live coverage: 1 = show the simulated demo feed on /tournaments/<slug>/live (on by default in dev, off in production).
LIVE_DEMO=

# Umpire console passcode, ONLY used when no database is configured (local demos). With MONGODB_URI, umpires use accounts.
UMPIRE_TOKEN=

# 1 = show labelled sample gallery images/testimonials in production (they always show in dev).
SHOW_PLACEHOLDERS=
